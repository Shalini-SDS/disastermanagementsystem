# MongoDB Atlas Connection String (REQUIRED)
# Get from: MongoDB Atlas → Your Cluster → Connect → Drivers → Node.js/Python
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority
# Replace:
#   - username: Your Atlas username (NOT email)
#   - password: Your Atlas password (URL encode special characters)
#   - cluster-name: Your cluster name (e.g., cluster0.os2ucpe)
#   - database-name: Your database name (e.g., disaster_db)
MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority

# Flask Security Key (change to random string in production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-key-here

# Server Configuration
PORT=5000
DEBUG=False
